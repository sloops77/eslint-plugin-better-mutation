{
  "name": "eslint-plugin-better-mutation",
  "version": "3.0.0",
  "description": "ESLint rules for controlling where and how mutation is used.",
  "license": "MIT",
  "repository": "sloops77/eslint-plugin-better-mutation",
  "author": {
    "name": "Andres Olave",
    "email": "andres@thinkingbytes.net",
    "url": "https://github.com/sloops77"
  },
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=26.0.0"
  },
  "scripts": {
    "init:ci": "rimraf reports coverage && mkdir -p reports coverage",
    "lint": "xo",
    "lint:ci": "xo --reporter junit > reports/lint-results.xml",
    "test": "node --test --experimental-test-coverage --test-coverage-include=index.js --test-coverage-include='rules/**' 'test/**/*.js'",
    "test:ci": "node --test --experimental-test-coverage --test-coverage-include=index.js --test-coverage-include='rules/**' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=reports/test-results.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info 'test/**/*.js'"
  },
  "files": [
    "index.js",
    "rules"
  ],
  "keywords": [
    "eslint",
    "plugin",
    "eslint-plugin",
    "eslintplugin",
    "fp",
    "FP",
    "function",
    "functional",
    "programming",
    "lodash",
    "mutation",
    "immutable",
    "function",
    "functions",
    "method",
    "methods"
  ],
  "dependencies": {
    "lodash": "~4.18.0"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "eslint-formatter-junit": "9.0.1",
    "eslint-plugin-eslint-plugin": "7.6.2",
    "eslint-plugin-n": "18.5.0",
    "rimraf": "6.1.4",
    "typescript": "7.0.2",
    "xo": "2.0.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
