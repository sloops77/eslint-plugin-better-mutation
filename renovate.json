{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "security:minimumReleaseAgeNpm",
    ":automergePatch",
    ":automergeRequireAllStatusChecks"
  ],
  "dependencyDashboard": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Review ESLint peer updates.",
      "matchDepTypes": [
        "peerDependencies"
      ],
      "matchPackageNames": [
        "eslint"
      ],
      "automerge": false,
      "labels": [
        "compatibility",
        "peer-dependency",
        "eslint"
      ]
    },
    {
      "description": "Review major ESLint test updates.",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-eslint-plugin",
        "eslint-plugin-n"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "labels": [
        "test-dependency",
        "eslint"
      ]
    },
    {
      "description": "Automerge non-major ESLint test updates.",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchPackageNames": [
        "eslint",
        "eslint-plugin-eslint-plugin",
        "eslint-plugin-n"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "labels": [
        "test-dependency",
        "eslint"
      ]
    },
    {
      "description": "Group XO linting updates.",
      "groupName": "xo linting",
      "matchPackageNames": [
        "eslint-formatter-junit",
        "xo"
      ],
      "labels": [
        "linting",
        "xo"
      ]
    },
    {
      "description": "eslint-formatter-junit is ESLint's JUnit formatter moved out of core; it is stable rather than abandoned.",
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "eslint-formatter-junit"
      ],
      "abandonmentThreshold": null
    },
    {
      "description": "Review major updates.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
